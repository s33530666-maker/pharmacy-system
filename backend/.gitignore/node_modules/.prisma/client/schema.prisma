generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String   @unique
  email            String?
  password         String
  role             String   @default("TECHNICIAN")
  status           String   @default("ACTIVE")
  maxDiscountLimit Float    @default(0.0)
  permissions      String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shifts   Shift[]
  sales    Sale[]
  expenses Expense[]
}

model Shift {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  openingCash  Float     @default(0)
  closingCash  Float?
  expectedCash Float?
  discrepancy  String?
  notes        String?
  startTime    DateTime
  endTime      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expenses Expense[]
  sales    Sale[]

  @@index([userId])
}

model Supplier {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String
  address    String
  city       String
  state      String
  postalCode String
  country    String
  balance    Float    @default(0.0)
  totalDebt  Float    @default(0.0)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchases Purchase[]
  batches   Batch[]
  debts     SupplierDebt[]
  payments  SupplierPayment[]
}

model Drug {
  id             String   @id @default(uuid())
  name           String
  arabicName     String?
  barcode        String?  @unique
  bagNumber      String?
  excelId        Int?
  externalId     String?
  genericName    String
  description    String?
  strength       String
  dosageForm     String
  manufacturer   String
  sellPrice      Float    @default(0)
  alternatePrice Float    @default(0)
  costPrice      Float    @default(0)
  stock          Int      @default(0)
  stripsPerBox   Int      @default(1)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batches      Batch[]
  alerts       Alert[]
  damagedDrugs DamagedDrug[]
}

model Batch {
  id                String   @id @default(uuid())
  drugId            String
  drug              Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  batchNumber       String   @unique
  quantity          Int
  expiryDate        DateTime
  manufacturingDate DateTime
  costPrice         Float
  sellingPrice      Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@index([drugId])
  @@index([supplierId])
  @@index([expiryDate])
}

model Purchase {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseDate  DateTime
  status        String   @default("PENDING")
  paymentStatus String   @default("PAID")
  totalAmount   Float
  paidAmount    Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Float
  totalCost  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([purchaseId])
  @@index([batchId])
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  email       String?  @unique
  phone       String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  country     String?
  totalPoints Int      @default(0)
  debtLimit   Float    @default(0) // 0 means no limit
  isVip       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales        Sale[]
  payments     Payment[]
  transactions CustomerTransaction[]
  account      CustomerAccount?
}

model Sale {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  saleDate      DateTime
  receiptNumber String?
  status        String   @default("COMPLETED")
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  grandTotal    Float    @default(0)
  paymentMethod String   @default("CASH")
  paymentStatus String   @default("PAID")
  cashPaid      Float    @default(0)
  changeReturn  Float    @default(0)
  earnedPoints  Int      @default(0)
  shiftId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    SaleItem[]
  payments Payment[]
  shift    Shift?     @relation(fields: [shiftId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([saleDate])
  @@index([receiptNumber])
  @@index([shiftId])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  drugId      String
  drugName    String?
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  returnedQty Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
  @@index([batchId])
  @@index([drugId])
}

model Payment {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount          Float
  paymentMethod   String
  paymentDate     DateTime
  referenceNumber String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([saleId])
}

model DamagedDrug {
  id        String   @id @default(uuid())
  drugId    String
  drug      Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
  quantity  Int
  reason    String
  costLoss  Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([drugId])
}

model Alert {
  id         String   @id @default(uuid())
  drugId     String
  drug       Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
  alertType  String
  message    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([drugId])
}

model SuspendedSale {
  id          String   @id @default(uuid())
  userId      String
  customerId  String?
  saleDate    DateTime @default(now())
  status      String   @default("SUSPENDED")
  totalAmount Float
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items SuspendedSaleItem[]

  @@index([userId])
}

model SuspendedSaleItem {
  id          String        @id @default(uuid())
  suspendedId String
  suspended   SuspendedSale @relation(fields: [suspendedId], references: [id], onDelete: Cascade)
  drugId      String
  drugName    String
  barcode     String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([suspendedId])
  @@index([drugId])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  expenseDate DateTime
  category    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId     String?
  shift       Shift?   @relation(fields: [shiftId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([shiftId])
}

model CustomerTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String   @default("DEBT")
  amount      Float
  balance     Float
  description String?
  saleId      String?
  paymentId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([saleId])
}

model CustomerAccount {
  id             String   @id @default(uuid())
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  totalDebt      Float    @default(0)
  totalPaid      Float    @default(0)
  currentBalance Float    @default(0)
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  userRole   String?
  action     String
  method     String
  endpoint   String
  ipAddress  String?
  userAgent  String?
  statusCode Int
  success    Boolean  @default(true)
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SupplierDebt {
  id             String    @id @default(uuid())
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  invoiceAmount  Float
  paidAmount     Float     @default(0)
  currentBalance Float     @default(0)
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments SupplierDebtPayment[]

  @@index([supplierId])
  @@index([dueDate])
}

model SupplierDebtPayment {
  id             String       @id @default(uuid())
  supplierDebtId String
  supplierDebt   SupplierDebt @relation(fields: [supplierDebtId], references: [id], onDelete: Cascade)
  amount         Float
  paymentDate    DateTime     @default(now())
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([supplierDebtId])
}

model SupplierPayment {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Float
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([date])
}

model License {
  id           String    @id @default(uuid())
  pharmacyName String
  licenseKey   String    @unique
  type         String // TRIAL, MONTHLY, YEARLY, LIFETIME
  status       String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  activatedAt  DateTime  @default(now())
  expiresAt    DateTime? // null = LIFETIME
  machineId    String? // optional: lock to machine
  usedAt       DateTime? // when the code was first activated
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SystemSettings {
  id                String   @id @default(uuid())
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt
}
